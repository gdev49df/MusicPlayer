{
  "name": "pripev",
  "productName": "Pripev",
  "version": "1.0.0",
  "description": "Pripev - lyric video maker",
  "author": "GwebStudio",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "build": {
    "appId": "studio.gweb.pripev",
    "productName": "Pripev",
    "copyright": "GwebStudio",
    "files": [
      "main.js",
      "preload.js",
      "app.html",
      "icon.png"
    ],
    "electronLanguages": [
      "ru",
      "en-US",
      "kk"
    ],
    "compression": "maximum",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Pripev-Setup.${ext}",
      "shortcutName": "Припев"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "gdev49df",
        "repo": "MusicPlayer"
      }
    ]
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
